# Copy to .env and fill in.

# Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Postgres connection string. Free hosted option: Neon (https://neon.tech).
# Use SEPARATE databases for dev and prod so local testing never touches real signups.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
